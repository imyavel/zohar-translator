# zohar-translator runtime config — шаблон.
# Скопировать в .env (рядом с этим файлом) и заполнить.
# В git коммитится только .env.example. .env уже в .gitignore.

# --- Telegram ---

# Bot token от @BotFather. Обязателен, даже если запускать --no-bot
# (валидация Pydantic). Для headless-режима без TG достаточно поставить
# любой dummy-токен формата "0:dummy" и не запускать bot.
TG_BOT_TOKEN=

# chat_id владельца — туда идут dashboard и команды бота.
# Узнать: написать боту любое сообщение и посмотреть update в логах,
# либо через @userinfobot.
TG_PRIVATE_CHAT_ID=

# Опциональный публичный канал для уведомлений об auto-deploy.
# Оставь пустым — публикация в канал отключится.
# TG_PUBLIC_CHANNEL=@your_channel_username

# --- Корпус ---

# Рабочая директория корпуса оператора. Здесь лежат:
#   Source/         — исходники (загружены через download_sefaria.py
#                     или своим скриптом)
#   Source/articles_catalog.json — план статей (см.
#                     reference/source_loader/CATALOG_STRUCTURE.md)
#   Translated/     — выходные .md и Site/
#   .batch/         — runtime-папка orchestrator'а
# НЕ путать с корнем репо zohar-translator (там лежат src/ и
# corpus_tools/).
HEB_ROOT=

# --- Логи ---

LOG_LEVEL=INFO

# --- Translator ---

# Сек на ОДИН translator subprocess. Default 1800 (30 мин).
TRANSLATOR_TIMEOUT_SECONDS=1800

# Effort для translator-агента. "" = дефолт CLI (для Opus 4.7 — adaptive).
# Возможные: "" | low | medium | high | xhigh | max.
TRANSLATOR_EFFORT=

# Путь к бинарю claude CLI. Пусто = взять из PATH.
# CLAUDE_BIN=

# --- Параллелизм ---

# Сколько translator'ов одновременно в одной волне. 1 = последовательно.
# Default 10 — empirically проверено для Pro/Max-аккаунта.
PARALLEL_TRANSLATORS=10

# Primer-pass: 1 статья solo для прогрева ephemeral_1h-cache,
# потом N-1 параллельно. Включать только если empirically доказано
# что cache шарится между параллельными сессиями.
PARALLEL_CACHE_PRIMER=false

# Сколько fail'ов подряд без success'а до emergency halt.
CONSECUTIVE_FAILURE_THRESHOLD=5

# Burst-detection: N fail'ов в окне M секунд → ранний halt.
BURST_WINDOW_SECONDS=30
BURST_THRESHOLD=3

# --- Чанкование ---

# Бюджет одного чанка в символах исходника. Translator на Шаге 4 промпта
# собирает параграфы, пока сумма символов не превысит этот лимит, потом
# фиксирует чанк (Write/Bash heredoc append). Параграф длиннее бюджета
# не режется — становится своим чанком.
CHUNK_BUDGET_CHARS=7500

# --- Dashboard ---

# Дебаунс для edit'ов pinned dashboard'а в TG. Защита от flood-control
# при большом числе параллельных article_done.
DASHBOARD_DEBOUNCE_SECONDS=3

# --- GitHub Pages auto-deploy (опционально) ---

# Personal Access Token с правом push в gh_repo.
# Если пусто — auto-deploy отключён, бот логирует одно warning и
# пропускает все попытки push.
GH_TOKEN=

# Основной репо для GH Pages (формат: owner/name). Публикуется на
# https://<owner>.github.io/<name>/.
GH_REPO=

# Git committer для авто-коммитов. Default — zohar-translator-bot /
# noreply email; можно переопределить.
# GH_COMMIT_USER=
# GH_COMMIT_EMAIL=

# Дебаунс между article_done и реальным push.
GH_DEPLOY_DEBOUNCE_SECONDS=30
# Минимальный интервал между двумя push'ами подряд.
GH_DEPLOY_MIN_INTERVAL_SECONDS=600

# --- build_poyasneniya.py (опционально) ---

# Картинка для standalone-страницы «Необходимые пояснения».
# Default — templates/assets/intro.jpg из репо.
# POYASNENIYA_INTRO_IMG=
